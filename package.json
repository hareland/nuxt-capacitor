{
  "name": "nuxt-capacitor-workspace",
  "description": "A layer for building nuxt apps with capacitor",
  "version": "0.3.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hareland/nuxt-capacitor.git"
  },
  "private": false,
  "scripts": {
    "prepare": "nuxt prepare layer",
    "postinstall": "pnpm dev:prepare",
    "dev:prepare": "nuxt prepare playground",
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build --prerender",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck layer",
    "test": "vitest run",
    "clean": "pnpm --filter playground clean",
    "release": "release-it"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.1.0",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "release-it": "^21.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  }
}
