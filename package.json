{
  "name": "nuxt-capacitor-workspace",
  "description": "A layer for building nuxt apps with capacitor",
  "version": "0.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/hareland/nuxt-capacitor.git"
  },
  "private": false,
  "scripts": {
    "prepare": "nuxt prepare layer",
    "dev:prepare": "nuxt prepare playground --extends ../layer",
    "dev": "pnpm dev --filter playground",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck layer",
    "layer:release": "release-it --config .release-it.layer.json",
    "release": "pnpm run layer:release && release-it"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "@nuxt/eslint-config": "^1.15.1",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.5",
    "eslint": "^10.0.0",
    "nuxt": "^4.3.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4",
    "@capacitor/cli": "^8.1.0"
  }
}
