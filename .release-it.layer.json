{
  "git": false,
  "github": false,
  "hooks": {
    "before:init": ["pnpm lint", "pnpm typecheck"],
    "before:release": ["cp ./README.md ./layer/README.md"],
    "after:release": "rm ./layer/README.md"
  },
  "npm": {
    "publish": true,
    "publishPath": "./layer"
  },
  "plugins": {
    "@release-it/bumper": {
      "in": "./layer/package.json",
      "out": "./layer/package.json"
    }
  }
} 